# Fuul read-only API key for Concrete's points program.
# points.concrete.xyz is built on Fuul (docs.fuul.xyz). Per-user points
# totals require Concrete's own project key on Fuul's /v1/payouts/totals
# endpoint — there is no public, unauthenticated per-user endpoint.
#
# How to get one:
#   1. Ask Blueprint Finance / Concrete for read-only Fuul API access, or
#   2. Open https://points.concrete.xyz in a browser with DevTools open,
#      go to the Network tab, reload, and find requests to api.fuul.xyz.
#      The Authorization: Bearer value there is a front-end-safe, read-only
#      key already shipped to every visitor's browser for display purposes.
#
# Leave blank to run the app without points data — vault positions still
# work fully without this.
FUUL_API_KEY=

# Optional: dedicated RPC endpoints (Alchemy/Infura/Ankr/QuickNode/etc).
# If left blank, the app falls back to viem's built-in public RPC for each
# chain. Those public endpoints are shared and rate-limited — if vault
# reads look wrong, slow, or inconsistent (especially on Arbitrum, which
# gets heavy public-RPC traffic), setting one of these is the fix.
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
